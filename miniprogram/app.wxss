page {
  --color-bg: #151311;
  --color-surface: #1c1917;
  --color-surface-raised: #24201d;
  --color-coral: #ff7668;
  --color-coral-strong: #ff685a;
  --color-coral-soft: rgba(255, 118, 104, 0.14);
  --color-text: #f7f1ec;
  --color-text-secondary: #b8aea7;
  --color-text-muted: #847d77;
  --color-border: #3a342f;
  --color-success: #91b68d;
  --color-warning: #d8aa69;
  --color-danger: #ff8f84;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 30rpx;
  --radius-pill: 999rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --duration-fast: 140ms;
  --duration-base: 240ms;

  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

button,
input,
textarea {
  font: inherit;
}

button::after {
  display: none;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

.page-content {
  padding: 32rpx 40rpx calc(180rpx + env(safe-area-inset-bottom));
}

.surface {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.eyebrow {
  color: var(--color-coral);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  color: var(--color-text);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.page-subtitle {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 54rpx 0 24rpx;
}

.section-heading::before {
  content: "";
  width: 8rpx;
  height: 38rpx;
  border-radius: var(--radius-pill);
  background: var(--color-coral);
}

.section-heading::after {
  content: "";
  flex: 1;
  height: 2rpx;
  background: var(--color-border);
}

.section-heading-text {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.primary-button,
.secondary-button,
.text-button {
  min-height: 96rpx;
  box-sizing: border-box;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 38rpx;
  font-size: 30rpx;
  font-weight: 700;
  transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) ease, background-color var(--duration-fast) ease;
}

.primary-button {
  background: var(--color-coral);
  color: #1a1412;
  border: 2rpx solid var(--color-coral);
}

.secondary-button {
  background: var(--color-surface);
  color: var(--color-text);
  border: 2rpx solid var(--color-border);
}

.text-button {
  min-height: 88rpx;
  background: transparent;
  color: var(--color-text-secondary);
  border: 0;
}

.primary-button:active,
.secondary-button:active,
.text-button:active {
  transform: scale(0.97);
  opacity: 0.86;
}

.primary-button[disabled] {
  background: #39332f;
  color: #746c66;
  border-color: #39332f;
  opacity: 1;
}

.field-label {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 14rpx;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
}

.field-required {
  color: var(--color-coral);
}

.field-optional,
.field-hint {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 400;
}

.field-input,
.field-textarea,
.field-picker {
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  background: var(--color-surface);
  color: var(--color-text);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  transition: border-color var(--duration-fast) ease, background-color var(--duration-fast) ease;
}

.field-textarea {
  min-height: 190rpx;
  line-height: 1.6;
}

.field-input.is-focused,
.field-textarea:focus,
.field-picker:active {
  border-color: var(--color-coral);
  background: var(--color-surface-raised);
}

.placeholder {
  color: var(--color-text-muted);
}

.enter {
  animation: enter var(--duration-base) var(--ease-out) both;
}

@keyframes enter {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.loading-state,
.empty-state,
.error-state {
  min-height: 440rpx;
  padding: 64rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
}

.state-copy {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: var(--color-coral);
  animation: loading-pulse 900ms ease-in-out infinite alternate;
}

@keyframes loading-pulse {
  from { opacity: 0.35; transform: scale(0.82); }
  to { opacity: 1; transform: scale(1); }
}

.safe-footer {
  padding-bottom: env(safe-area-inset-bottom);
}

@media (prefers-reduced-motion: reduce) {
  .enter,
  .loading-dot {
    animation: none !important;
  }

  button,
  .field-input,
  .field-textarea,
  .field-picker {
    transition: none !important;
  }
}
