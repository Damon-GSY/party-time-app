page {
  --color-bg: #f5f0e7;
  --color-surface: #fffcf6;
  --color-surface-raised: #efeadf;
  --color-paper: #dcc9a9;
  --color-paper-raised: #f4ead8;
  --color-ink: #26382e;
  --color-coral: #b83a2d;
  --color-coral-strong: #a82f25;
  --color-coral-soft: #f5e3da;
  --color-text: #26382e;
  --color-text-secondary: #626b60;
  --color-text-muted: #656e62;
  --color-on-accent: #fffcf6;
  --color-border: #d9d9cc;
  --color-success: #4e6851;
  --color-success-ink: #405944;
  --color-success-soft: #e8ecdf;
  --color-warning: #89642d;
  --color-danger: #a82f25;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 24rpx;
  --radius-pill: 999rpx;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-5: 40rpx;
  --space-6: 48rpx;
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-in: cubic-bezier(0.55, 0, 1, 0.45);
  --duration-instant: 80ms;
  --duration-fast: 140ms;
  --duration-base: 240ms;
  --duration-sheet: 280ms;

  min-height: 100%;
  background: var(--color-bg);
  color: var(--color-text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

button,
input,
textarea {
  font: inherit;
}

button::after {
  display: none;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  background-color: var(--color-bg);
}

.grain-layer {
  display: none;
}

.home-content,
.create-content,
.vote-content,
.result-content,
.notifications-content,
.profile-content,
.history-content,
.poster-preview,
.poster-actions,
.loading-state,
.empty-state,
.error-state {
  position: relative;
  z-index: 1;
}

.page-content {
  padding: 32rpx 40rpx calc(180rpx + env(safe-area-inset-bottom));
}

.core-flow-header {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.core-flow-body {
  min-width: 0;
  flex: 1;
}

.core-back-button {
  width: 96rpx;
  height: 96rpx;
  min-width: 96rpx;
  min-height: 96rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.core-back-icon {
  width: 44rpx;
  height: 44rpx;
  filter: brightness(0) opacity(.75);
}

.state-back-button {
  position: fixed;
  top: 96rpx;
  top: calc(96rpx + constant(safe-area-inset-top));
  top: calc(96rpx + env(safe-area-inset-top));
  left: 44rpx;
  z-index: 30;
}

.surface {
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
}

.eyebrow {
  display: block;
  color: var(--color-coral);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.page-title {
  display: block;
  margin-top: 14rpx;
  color: var(--color-text);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.6;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 72rpx 0 34rpx;
}

.section-heading::before {
  content: "";
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-coral);
}

.section-heading::after {
  content: "";
  flex: 1;
  height: 2rpx;
  background: var(--color-border);
}

.section-heading-text {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.primary-button,
.secondary-button,
.text-button {
  min-height: 96rpx;
  box-sizing: border-box;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 38rpx;
  font-size: 30rpx;
  font-weight: 700;
  transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) ease, background-color var(--duration-fast) ease;
}

.primary-button {
  background: var(--color-coral);
  color: var(--color-on-accent);
  border: 2rpx solid var(--color-coral);
}

.secondary-button {
  background: var(--color-surface);
  color: var(--color-text);
  border: 2rpx solid var(--color-border);
}

.text-button {
  min-height: 88rpx;
  background: transparent;
  color: var(--color-text-secondary);
  border: 0;
}

.primary-button:active,
.secondary-button:active,
.text-button:active {
  transform: scale(0.97);
  opacity: 0.86;
}

.primary-button[disabled],
.secondary-button[disabled] {
  background: #e7e4da;
  color: #74776d;
  border-color: #d9d9cc;
  opacity: 1;
}

.field-label {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 14rpx;
  color: var(--color-text);
  font-size: 26rpx;
  font-weight: 600;
}

.field-required {
  color: var(--color-coral);
}

.field-optional,
.field-hint {
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 400;
}

.field-input,
.field-textarea,
.field-picker {
  width: 100%;
  min-height: 96rpx;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  background: var(--color-surface);
  color: var(--color-ink);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  transition: border-color var(--duration-fast) ease, background-color var(--duration-fast) ease;
}

.field-textarea {
  min-height: 190rpx;
  line-height: 1.6;
}

.field-input.is-focused,
.field-textarea:focus,
.field-picker:active {
  border-color: var(--color-coral);
  background: var(--color-surface);
}

.placeholder {
  color: #656e62;
}

.enter {
  animation: enter var(--duration-base) var(--ease-out) both;
}

@keyframes enter {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.loading-state,
.empty-state,
.error-state {
  min-height: 440rpx;
  padding: 64rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.vote-page > .loading-state,
.vote-page > .error-state,
.result-page > .loading-state,
.result-page > .error-state {
  min-height: 100vh;
  padding: 220rpx 44rpx 120rpx;
  padding: calc(220rpx + constant(safe-area-inset-top)) 44rpx calc(120rpx + constant(safe-area-inset-bottom));
  padding: calc(220rpx + env(safe-area-inset-top)) 44rpx calc(120rpx + env(safe-area-inset-bottom));
}

.state-title {
  color: var(--color-text);
  font-size: 32rpx;
  font-weight: 700;
}

.state-copy {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.7;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: var(--color-coral);
  animation: loading-pulse 900ms ease-in-out infinite alternate;
}

@keyframes loading-pulse {
  from { opacity: 0.35; transform: scale(0.82); }
  to { opacity: 1; transform: scale(1); }
}

.safe-footer {
  padding-bottom: env(safe-area-inset-bottom);
}

@media (prefers-reduced-motion: reduce) {
  .enter,
  .loading-dot,
  .slots-grid,
  .modal-backdrop,
  .success-sheet,
  .slot-sheet,
  .about-sheet {
    animation: none !important;
    transform: none !important;
  }

  button,
  .field-input,
  .field-textarea,
  .field-picker {
    transition-duration: 0.01ms !important;
  }
}
