<view class="page-shell profile-page">
  <view class="profile-content">
    <view class="profile-heading enter">
      <text class="eyebrow">我的</text>
      <text class="page-title">你的聚会档案</text>
    </view>

    <view class="identity-section">
      <button class="avatar-button" bindtap="changeAvatar" aria-label="更换头像">
        <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" wx:if="{{userInfo.avatarUrl}}" />
        <text class="avatar-letter" wx:else>{{userInfo.customNickname[0] || userInfo.nickName[0] || '我'}}</text>
      </button>
      <view class="identity-body">
        <text class="field-hint">昵称</text>
        <input class="nickname-input" placeholder="设置昵称" placeholder-class="placeholder" value="{{userInfo.customNickname || userInfo.nickName || ''}}" bindinput="onNicknameInput" bindblur="saveNickname" maxlength="12" />
        <text class="avatar-hint">点击头像可更换</text>
      </view>
    </view>

    <view class="profile-stats">
      <button class="profile-stat" bindtap="goToHistory" data-type="created">
        <text class="stat-number">{{displayCreatedCount}}</text>
        <text class="stat-label">创建聚会</text>
      </button>
      <view class="stat-divider"></view>
      <button class="profile-stat" bindtap="goToHistory" data-type="joined">
        <text class="stat-number">{{displayJoinedCount}}</text>
        <text class="stat-label">参与聚会</text>
      </button>
    </view>

    <view class="section-heading"><text class="section-heading-text">管理</text></view>
    <view class="menu-list">
      <button class="menu-row" bindtap="goToHistory" data-type="created"><text>我的创建</text><text class="menu-detail">查看全部</text></button>
      <button class="menu-row" bindtap="goToHistory" data-type="joined"><text>我的参与</text><text class="menu-detail">查看全部</text></button>
      <button class="menu-row" bindtap="goToNotification"><text>通知中心</text><text class="menu-detail">提醒记录</text></button>
      <button class="menu-row" bindtap="showAbout"><text>关于聚会时间</text><text class="menu-detail">v1.0.0</text></button>
    </view>
  </view>

  <view class="about-modal {{showAboutModal ? 'is-open' : ''}}" catchtouchmove="preventMove">
    <view class="modal-backdrop" bindtap="hideAbout"></view>
    <view class="about-sheet">
      <text class="about-title">聚会时间</text>
      <text class="about-version">v1.0.0</text>
      <text class="about-copy">轻松找到大家都有空的时间，让聚会安排不再纠结。</text>
      <view class="about-features">
        <text>创建时间投票</text>
        <text>汇总空闲时段</text>
        <text>分享给参与者</text>
      </view>
      <button class="primary-button" bindtap="hideAbout">知道了</button>
    </view>
  </view>
</view>
