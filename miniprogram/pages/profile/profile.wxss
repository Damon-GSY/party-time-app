.profile-page { background: var(--color-bg); }
.profile-content { padding: calc(96rpx + env(safe-area-inset-top)) 44rpx calc(72rpx + env(safe-area-inset-bottom)); }
.profile-heading { margin-bottom: 48rpx; padding-bottom: 34rpx; border-bottom: 2rpx solid var(--color-border); }
.identity-section { display: flex; align-items: center; gap: 28rpx; padding: 32rpx 28rpx; background: var(--color-surface); border: 2rpx solid var(--color-border); border-radius: 24rpx 24rpx 0 0; }
.avatar-button { width: 112rpx; height: 112rpx; margin: 0; padding: 0; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--color-success-soft); color: var(--color-success); border: 2rpx solid var(--color-border); border-radius: 28rpx; }
.user-avatar { width: 100%; height: 100%; }
.avatar-letter { font-size: 42rpx; font-weight: 700; }
.identity-body { min-width: 0; flex: 1; }
.nickname-input { width: 100%; min-height: 68rpx; padding: 0; color: var(--color-text); border-bottom: 2rpx solid var(--color-border); font-size: 32rpx; font-weight: 600; }
.nickname-input:focus { border-color: var(--color-coral); }
.avatar-hint { display: block; margin-top: 10rpx; color: var(--color-text-muted); font-size: 22rpx; }
.profile-stats { min-height: 156rpx; margin-top: -2rpx; display: flex; align-items: stretch; background: var(--color-surface); border: 2rpx solid var(--color-border); border-radius: 0 0 24rpx 24rpx; }
.profile-stat { margin: 0; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; background: transparent; color: var(--color-text); border-radius: 0; }
.stat-number { color: var(--color-success); font-size: 48rpx; font-weight: 600; line-height: 1.2; font-family: Georgia, "Times New Roman", serif; }
.stat-label { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.stat-divider { width: 2rpx; margin: 28rpx 0; background: var(--color-border); }
.menu-list { padding: 0 26rpx; background: var(--color-surface); border: 2rpx solid var(--color-border); border-radius: var(--radius-lg); }
.menu-row { width: 100%; min-height: 128rpx; margin: 0; padding: 0; display: flex; align-items: center; gap: 18rpx; background: transparent; color: var(--color-text); border-bottom: 2rpx solid var(--color-border); border-radius: 0; font-size: 28rpx; text-align: left; }
.menu-icon { width: 46rpx; height: 46rpx; flex-shrink: 0; }
.menu-label { min-width: 0; flex: 1; }
.menu-detail { color: var(--color-text-muted); font-size: 23rpx; font-weight: 400; }
.menu-chevron { width: 38rpx; height: 38rpx; flex-shrink: 0; }
.menu-row:last-child { border-bottom: 0; }
.menu-row:active, .profile-stat:active { background: var(--color-success-soft); }
.about-modal { position: fixed; inset: 0; z-index: 60; visibility: hidden; pointer-events: none; }
.about-modal.is-open { visibility: visible; pointer-events: auto; }
.modal-backdrop { position: absolute; inset: 0; background: rgba(38,56,46,.3); opacity: 0; transition: opacity 180ms var(--ease-standard); }
.about-modal.is-open .modal-backdrop { opacity: 1; }
.about-sheet { position: absolute; right: 0; bottom: 0; left: 0; padding: 46rpx 40rpx calc(38rpx + env(safe-area-inset-bottom)); background: var(--color-surface); border-top: 2rpx solid var(--color-border); border-radius: 28rpx 28rpx 0 0; transform: translateY(100%); transition: transform 180ms var(--ease-in); }
.about-modal.is-open .about-sheet { transform: translateY(0); transition-duration: var(--duration-sheet); transition-timing-function: var(--ease-out); }
.about-title, .about-version, .about-copy, .about-features text { display: block; }
.about-title { font-size: 38rpx; font-weight: 700; }
.about-version { margin-top: 6rpx; color: var(--color-coral); font-size: 22rpx; }
.about-copy { margin-top: 22rpx; color: var(--color-text-secondary); font-size: 25rpx; line-height: 1.65; }
.about-features { margin: 28rpx 0; padding: 22rpx 0; border-top: 2rpx solid var(--color-border); border-bottom: 2rpx solid var(--color-border); }
.about-features text { min-height: 54rpx; color: var(--color-text-secondary); font-size: 24rpx; }
