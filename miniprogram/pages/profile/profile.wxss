.profile-page { background: var(--color-bg); }
.profile-content { padding: 36rpx 40rpx calc(60rpx + env(safe-area-inset-bottom)); }
.profile-heading { margin-bottom: 46rpx; }
.identity-section { display: flex; align-items: center; gap: 28rpx; }
.avatar-button { width: 124rpx; height: 124rpx; margin: 0; padding: 0; flex-shrink: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--color-coral-soft); color: var(--color-coral); border: 2rpx solid rgba(255,118,104,.5); border-radius: 50%; }
.user-avatar { width: 100%; height: 100%; }
.avatar-letter { font-size: 42rpx; font-weight: 700; }
.identity-body { min-width: 0; flex: 1; }
.nickname-input { width: 100%; min-height: 68rpx; padding: 0; color: var(--color-text); border-bottom: 2rpx solid var(--color-border); font-size: 32rpx; font-weight: 600; }
.nickname-input:focus { border-color: var(--color-coral); }
.avatar-hint { display: block; margin-top: 10rpx; color: var(--color-text-muted); font-size: 22rpx; }
.profile-stats { min-height: 150rpx; margin-top: 42rpx; display: flex; align-items: stretch; background: var(--color-surface); border: 2rpx solid var(--color-border); border-radius: var(--radius-lg); }
.profile-stat { margin: 0; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; background: transparent; color: var(--color-text); border-radius: 0; }
.stat-number { color: var(--color-coral); font-size: 42rpx; font-weight: 700; }
.stat-label { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.stat-divider { width: 2rpx; margin: 28rpx 0; background: var(--color-border); }
.menu-list { border-top: 2rpx solid var(--color-border); }
.menu-row { width: 100%; min-height: 112rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: space-between; background: transparent; color: var(--color-text); border-bottom: 2rpx solid var(--color-border); border-radius: 0; font-size: 28rpx; text-align: left; }
.menu-detail { color: var(--color-text-muted); font-size: 23rpx; font-weight: 400; }
.about-modal { position: fixed; inset: 0; z-index: 60; visibility: hidden; pointer-events: none; }
.about-modal.is-open { visibility: visible; pointer-events: auto; }
.modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,.66); opacity: 0; transition: opacity 220ms ease; }
.about-modal.is-open .modal-backdrop { opacity: 1; }
.about-sheet { position: absolute; right: 0; bottom: 0; left: 0; padding: 46rpx 40rpx calc(38rpx + env(safe-area-inset-bottom)); background: var(--color-surface-raised); border-top: 2rpx solid var(--color-border); border-radius: 36rpx 36rpx 0 0; transform: translateY(100%); transition: transform 280ms var(--ease-out); }
.about-modal.is-open .about-sheet { transform: translateY(0); }
.about-title, .about-version, .about-copy, .about-features text { display: block; }
.about-title { font-size: 38rpx; font-weight: 700; }
.about-version { margin-top: 6rpx; color: var(--color-coral); font-size: 22rpx; }
.about-copy { margin-top: 22rpx; color: var(--color-text-secondary); font-size: 25rpx; line-height: 1.65; }
.about-features { margin: 28rpx 0; padding: 22rpx 0; border-top: 2rpx solid var(--color-border); border-bottom: 2rpx solid var(--color-border); }
.about-features text { min-height: 54rpx; color: var(--color-text-secondary); font-size: 24rpx; }
