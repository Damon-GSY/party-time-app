.history-page { background: var(--color-bg); }
.history-content { padding: 36rpx 40rpx calc(60rpx + env(safe-area-inset-bottom)); }
.history-header { margin-bottom: 34rpx; }
.history-tabs { display: flex; padding: 6rpx; background: var(--color-surface); border: 2rpx solid var(--color-border); border-radius: var(--radius-md); }
.history-tab { min-height: 88rpx; margin: 0; flex: 1; background: transparent; color: var(--color-text-secondary); border-radius: 16rpx; font-size: 25rpx; }
.history-tab.is-active { background: var(--color-coral-soft); color: var(--color-coral); font-weight: 600; }
.event-list { margin-top: 32rpx; border-top: 2rpx solid var(--color-border); }
.history-row { width: 100%; min-height: 154rpx; margin: 0; padding: 22rpx 0; display: flex; align-items: center; gap: 22rpx; background: transparent; color: var(--color-text); border-bottom: 2rpx solid var(--color-border); border-radius: 0; text-align: left; }
.history-date { width: 88rpx; height: 88rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx solid var(--color-border); border-radius: 50%; }
.history-date text { color: var(--color-text-secondary); font-size: 18rpx; }
.history-date strong { margin-top: 3rpx; font-size: 29rpx; }
.history-body { min-width: 0; flex: 1; }
.history-title, .history-meta { display: block; }
.history-title { overflow: hidden; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.history-meta { margin-top: 5rpx; color: var(--color-text-muted); font-size: 21rpx; }
.history-status { color: var(--color-success); font-size: 22rpx; }
.history-status.is-expired { color: var(--color-text-muted); }
.retry-button, .empty-button { min-width: 240rpx; margin-top: 30rpx; }
