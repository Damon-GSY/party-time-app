.history-page { background: var(--color-bg); }
.history-content { padding: 64rpx 44rpx calc(72rpx + env(safe-area-inset-bottom)); }
.history-header { margin-bottom: 38rpx; padding-bottom: 32rpx; border-bottom: 2rpx solid var(--color-border); }
.history-tabs { display: flex; gap: 28rpx; border-bottom: 2rpx solid var(--color-border); }
.history-tab { min-height: 88rpx; margin: 0; padding: 0 8rpx; flex: 1; background: transparent; color: var(--color-text-secondary); border-bottom: 4rpx solid transparent; border-radius: 0; font-size: 27rpx; transition: color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), transform var(--duration-instant) var(--ease-standard); }
.history-tab:active { transform: scale(.98); }
.history-tab.is-active { color: var(--color-coral); border-bottom-color: var(--color-coral); font-weight: 600; }
.event-list { margin-top: 28rpx; }
.history-row { width: 100%; min-height: 160rpx; margin: 0 0 18rpx; padding: 24rpx; display: flex; align-items: center; gap: 22rpx; background: var(--color-surface); color: var(--color-text); border: 2rpx solid var(--color-border); border-radius: var(--radius-md); text-align: left; }
.history-row:active { background: var(--color-success-soft); }
.history-date { width: 84rpx; height: 100rpx; flex-shrink: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--color-success-soft); border: 2rpx solid var(--color-border); border-radius: 12rpx; }
.history-date text { color: var(--color-text-secondary); font-size: 18rpx; }
.history-date .history-day { margin-top: 3rpx; color: var(--color-text); font-size: 36rpx; line-height: 1.1; font-weight: 600; }
.history-body { min-width: 0; flex: 1; }
.history-title, .history-meta { display: block; }
.history-title { overflow: hidden; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.history-meta { margin-top: 5rpx; color: var(--color-text-muted); font-size: 21rpx; }
.history-status { max-width: 90rpx; color: var(--color-success); font-size: 22rpx; }
.history-status.is-expired { color: var(--color-text-muted); }
.retry-button, .empty-button { min-width: 240rpx; margin-top: 30rpx; }
