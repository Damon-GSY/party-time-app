<view class="page-shell history-page">
  <image class="grain-layer" src="/assets/textures/warm-grain.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="history-content">
    <view class="history-header">
      <text class="eyebrow">历史</text>
      <text class="page-title">全部聚会</text>
    </view>

    <view class="history-tabs">
      <button class="history-tab {{activeTab === 'created' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="created">我创建的</button>
      <button class="history-tab {{activeTab === 'joined' ? 'is-active' : ''}}" bindtap="switchTab" data-tab="joined">我参与的</button>
    </view>

    <view class="loading-state" wx:if="{{loading && events.length === 0}}"><view class="loading-dot"></view><text class="state-copy">正在加载聚会</text></view>
    <view class="error-state" wx:elif="{{loadError}}"><text class="state-title">暂时无法加载</text><text class="state-copy">检查网络后再试一次。</text><button class="secondary-button retry-button" bindtap="loadEvents">重新加载</button></view>

    <view class="event-list" wx:else>
      <button class="history-row" wx:for="{{events}}" wx:key="_id" bindtap="goToResult" data-id="{{item._id}}">
        <view class="history-date"><text>{{item.startMonth}}月</text><strong>{{item.startDay}}</strong></view>
        <view class="history-body"><text class="history-title">{{item.name}}</text><text class="history-meta">{{item.dateRangeText}}</text><text class="history-meta">{{item.participantCount || 0}} 人参与</text></view>
        <text class="history-status {{item.expired ? 'is-expired' : ''}}">{{item.statusText}}</text>
      </button>

      <view class="empty-state" wx:if="{{!loading && events.length === 0}}">
        <text class="state-title">{{activeTab === 'created' ? '还没有创建过聚会' : '还没有参与过聚会'}}</text>
        <text class="state-copy">{{activeTab === 'created' ? '创建第一个时间投票吧。' : '通过好友分享的链接参与投票。'}}</text>
        <button class="primary-button empty-button" bindtap="goCreate" wx:if="{{activeTab === 'created'}}">创建聚会</button>
        <button class="secondary-button empty-button" bindtap="goBack" wx:else>返回首页</button>
      </view>
    </view>
  </view>
</view>
