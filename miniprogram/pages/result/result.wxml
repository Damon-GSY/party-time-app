<view class="page-shell result-page">
  <image class="grain-layer" src="/assets/textures/warm-grain.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="loading-state" wx:if="{{loading}}">
    <button class="core-back-button state-back-button" bindtap="goBack" aria-label="返回聚会首页"><image class="core-back-icon" src="/assets/icons/arrow-left-primary.png" mode="aspectFit" aria-hidden="true"></image></button>
    <view class="loading-dot"></view>
    <text class="state-copy">正在汇总大家的时间</text>
  </view>

  <view class="error-state" wx:elif="{{loadError}}">
    <button class="core-back-button state-back-button" bindtap="goBack" aria-label="返回聚会首页"><image class="core-back-icon" src="/assets/icons/arrow-left-primary.png" mode="aspectFit" aria-hidden="true"></image></button>
    <text class="state-title">暂时无法加载结果</text>
    <text class="state-copy">请检查网络后重试。</text>
    <button class="secondary-button state-action" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
    <view class="result-content">
      <view class="result-header core-flow-header enter">
        <button class="core-back-button" bindtap="goBack" aria-label="返回聚会首页"><image class="core-back-icon" src="/assets/icons/arrow-left-primary.png" mode="aspectFit" aria-hidden="true"></image></button>
        <view class="core-flow-body">
          <view class="result-title-row">
            <text class="page-title">{{event.name}}</text>
            <text class="status-pill {{event.expired ? 'is-expired' : ''}}">{{event.expired ? '已结束' : event.expireText}}</text>
          </view>
          <text class="page-subtitle">{{event.dateRangeText}}</text>
          <text class="event-note" wx:if="{{event.note}}">{{event.note}}</text>
        </view>
      </view>

      <view class="created-notice" wx:if="{{justCreated}}">
        <text class="created-title">聚会创建好了</text>
        <text class="created-copy">先填写自己的时间，再分享给朋友。</text>
      </view>

      <view class="section-heading">
        <text class="section-heading-text">最佳时间</text>
      </view>

      <view class="best-card" wx:if="{{bestSlot.timeText}}">
        <text class="best-label">当前重合最多</text>
        <text class="best-time"><text class="best-date">{{bestSlot.dateText}}</text><text class="best-range">{{bestSlot.rangeText}}</text></text>
        <view class="best-meta">
          <text class="best-count">{{bestSlot.count}} 人有空</text>
          <text class="best-percent">{{bestSlot.percent}}%</text>
        </view>
      </view>

      <view class="best-card is-empty" wx:else>
        <text class="best-label">还没有投票</text>
        <text class="best-time">等待第一个回应</text>
        <text class="best-empty-copy">分享活动后，结果会自动出现在这里。</text>
      </view>

      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value">{{participantCount}}</text>
          <text class="stat-label">参与人数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{bestSlot.count || 0}}</text>
          <text class="stat-label">最高票数</text>
        </view>
      </view>

      <block wx:if="{{participantCount > 0}}">
        <view class="section-heading">
          <text class="section-heading-text">时段分布</text>
        </view>
        <text class="heatmap-help">横向查看其他日期，点击格子查看参与者。</text>

        <scroll-view scroll-x class="heatmap-scroll" enhanced show-scrollbar="false">
          <view class="heatmap-columns">
            <view class="heatmap-column" wx:for="{{dates}}" wx:key="date">
              <view class="heatmap-date">
                <text class="heatmap-weekday">{{item.weekday}}</text>
                <text class="heatmap-day">{{item.dateText}}</text>
              </view>
              <button
                class="heatmap-cell level-{{item.level}}"
                wx:for="{{item.slots}}"
                wx:key="slotId"
                bindtap="showSlotDetail"
                data-slot-id="{{item.slotId}}"
                data-date="{{item.date}}"
                data-index="{{item.slotIndex}}"
                aria-label="{{item.timeLabel}}，{{item.count}} 人有空"
              >
                <text class="heatmap-time">{{item.shortLabel}}</text>
                <text class="heatmap-count">{{item.count}} 人</text>
              </button>
            </view>
          </view>
        </scroll-view>

        <view class="section-heading">
          <text class="section-heading-text">参与者</text>
        </view>
        <view class="participants-list">
          <view class="participant-row" wx:for="{{participants}}" wx:key="_id">
            <view class="participant-avatar" style="background: {{item.avatarColor}};">{{item.initial}}</view>
            <view class="participant-body">
              <text class="participant-name">{{item.nickname}}</text>
              <text class="participant-meta">选择了 {{item.slotCount}} 个时段</text>
            </view>
          </view>
        </view>
      </block>

      <view class="action-grid">
        <button class="secondary-button action-button" open-type="share">分享活动</button>
        <button class="secondary-button action-button" bindtap="goToPoster">生成海报</button>
        <button class="secondary-button action-button" bindtap="notifyParticipants" wx:if="{{notificationsConfigured && isCreator && participantCount > 0 && bestSlot.timeText}}" disabled="{{notifying}}">{{notifying ? '发送中' : '通知参与者'}}</button>
        <button class="danger-button action-button" bindtap="deleteEvent" wx:if="{{isCreator}}" disabled="{{deleting}}">{{deleting ? '删除中' : '删除聚会'}}</button>
      </view>
    </view>

    <view class="result-footer safe-footer" wx:if="{{!event.expired}}">
      <button class="primary-button result-primary" bindtap="goToVote">填写或修改时间</button>
    </view>

    <view wx:if="{{slotModalMounted}}" class="slot-modal {{showSlotModal ? 'is-open' : ''}}" catchtouchmove="preventMove">
      <view class="modal-backdrop" bindtap="closeSlotModal"></view>
      <view class="slot-sheet" aria-role="dialog" aria-label="时段参与详情">
        <view class="slot-sheet-header">
          <view>
            <text class="slot-sheet-title">{{selectedSlotInfo.dateText}}</text>
            <text class="slot-sheet-time">{{selectedSlotInfo.timeText}}</text>
          </view>
          <button class="close-button" bindtap="closeSlotModal">关闭</button>
        </view>
        <text class="slot-sheet-count">{{selectedSlotInfo.count}} 人有空</text>
        <view class="slot-user-list" wx:if="{{selectedSlotInfo.users.length > 0}}">
          <text class="slot-user" wx:for="{{selectedSlotInfo.users}}" wx:key="*this">{{item}}</text>
        </view>
        <text class="no-slot-users" wx:else>暂时没有人选择这个时段</text>
      </view>
    </view>
  </block>
</view>
