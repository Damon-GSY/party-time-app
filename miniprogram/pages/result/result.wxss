.result-page {
  background: var(--color-bg);
}

.result-content {
  padding: 96rpx 44rpx 206rpx;
  padding: calc(96rpx + constant(safe-area-inset-top)) 44rpx calc(206rpx + constant(safe-area-inset-bottom));
  padding: calc(96rpx + env(safe-area-inset-top)) 44rpx calc(206rpx + env(safe-area-inset-bottom));
}

.result-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.result-title-row .page-title {
  min-width: 0;
  flex: 1;
}

.status-pill {
  min-height: 52rpx;
  padding: 0 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  color: var(--color-success);
  background: rgba(145, 182, 141, 0.12);
  border-radius: var(--radius-pill);
  font-size: 21rpx;
}

.status-pill.is-expired {
  color: var(--color-text-muted);
  background: var(--color-surface);
}

.event-note {
  display: block;
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.created-notice {
  margin-top: 32rpx;
  padding: 24rpx 26rpx;
  background: var(--color-coral-soft);
  border-left: 6rpx solid var(--color-coral);
  border-radius: var(--radius-sm);
}

.created-title,
.created-copy {
  display: block;
}

.created-title {
  color: var(--color-coral);
  font-size: 25rpx;
  font-weight: 600;
}

.created-copy {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.best-card {
  padding: 44rpx;
  background: var(--color-surface);
  border: 2rpx solid rgba(242, 122, 106, 0.55);
  border-left: 8rpx solid var(--color-coral);
  border-radius: 28rpx;
}

.best-card.is-empty {
  background: var(--color-surface);
  border-color: var(--color-border);
}

.best-label,
.best-time,
.best-empty-copy {
  display: block;
}

.best-label {
  color: var(--color-coral);
  font-size: 23rpx;
  font-weight: 600;
}

.best-card.is-empty .best-label {
  color: var(--color-text-muted);
}

.best-time {
  margin-top: 14rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.4;
}

.best-date,
.best-range {
  display: block;
}

.best-range {
  margin-top: 4rpx;
  white-space: nowrap;
}

.best-meta {
  margin-top: 18rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.best-count {
  color: var(--color-coral);
  font-size: 26rpx;
  font-weight: 600;
}

.best-percent {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.best-empty-copy {
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.stats-row {
  margin-top: 24rpx;
  padding: 32rpx 0;
  display: flex;
  align-items: stretch;
  border-top: 2rpx solid var(--color-border);
  border-bottom: 2rpx solid var(--color-border);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  color: var(--color-text);
  font-size: 60rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.stat-divider {
  width: 2rpx;
  background: var(--color-border);
}

.heatmap-help {
  display: block;
  margin-top: -12rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
}

.heatmap-scroll {
  width: calc(100% + 40rpx);
  margin-top: 24rpx;
}

.heatmap-columns {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 40rpx;
}

.heatmap-column {
  width: 192rpx;
  flex-shrink: 0;
}

.heatmap-date {
  min-height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-surface-raised);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.heatmap-weekday {
  color: var(--color-text-secondary);
  font-size: 20rpx;
}

.heatmap-day {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.heatmap-cell {
  width: 100%;
  min-height: 104rpx;
  margin: 12rpx 0 0;
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.heatmap-cell.level-1 { background: rgba(255, 118, 104, 0.12); }
.heatmap-cell.level-2 { background: rgba(255, 118, 104, 0.24); }
.heatmap-cell.level-3 { background: rgba(255, 118, 104, 0.46); color: var(--color-text); }
.heatmap-cell.level-4 { background: var(--color-coral); color: #1a1412; border-color: var(--color-coral); }

.heatmap-time {
  font-size: 21rpx;
  font-weight: 600;
}

.heatmap-count {
  font-size: 20rpx;
}

.participants-list {
  border-top: 2rpx solid var(--color-border);
}

.participant-row {
  min-height: 124rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.participant-avatar {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.participant-body {
  min-width: 0;
  flex: 1;
}

.participant-name,
.participant-meta {
  display: block;
}

.participant-name {
  font-size: 27rpx;
  font-weight: 600;
}

.participant-meta {
  margin-top: 5rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 46rpx;
}

.action-button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.danger-button {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 143, 132, 0.1);
  color: var(--color-danger);
  border: 2rpx solid rgba(255, 143, 132, 0.35);
  border-radius: var(--radius-pill);
}

.result-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 22rpx 44rpx;
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-border);
}

.result-primary {
  width: 100%;
  margin: 0;
}

.state-action {
  min-width: 240rpx;
  margin-top: 32rpx;
}

.slot-modal {
  position: fixed;
  inset: 0;
  z-index: 60;
  visibility: hidden;
  pointer-events: none;
}

.slot-modal.is-open {
  visibility: visible;
  pointer-events: auto;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.66);
  opacity: 0;
  transition: opacity 180ms var(--ease-standard);
}

.slot-modal.is-open .modal-backdrop {
  opacity: 1;
}

.slot-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 38rpx 40rpx calc(38rpx + env(safe-area-inset-bottom));
  background: var(--color-surface-raised);
  border-radius: 36rpx 36rpx 0 0;
  border-top: 2rpx solid var(--color-border);
  transform: translateY(100%);
  transition: transform 180ms var(--ease-in);
}

.slot-modal.is-open .slot-sheet {
  transform: translateY(0);
  transition-duration: var(--duration-sheet);
  transition-timing-function: var(--ease-out);
}

.slot-sheet-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.slot-sheet-title,
.slot-sheet-time {
  display: block;
}

.slot-sheet-title {
  font-size: 31rpx;
  font-weight: 700;
}

.slot-sheet-time {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.close-button {
  min-width: 100rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  font-size: 23rpx;
}

.slot-sheet-count {
  display: block;
  margin-top: 24rpx;
  color: var(--color-coral);
  font-size: 26rpx;
  font-weight: 600;
}

.slot-user-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.slot-user {
  padding: 14rpx 20rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.no-slot-users {
  display: block;
  margin-top: 22rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}
