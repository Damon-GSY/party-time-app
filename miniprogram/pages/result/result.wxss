.result-page { background: var(--color-bg); }
.result-content { padding: 96rpx 36rpx 206rpx; padding: calc(96rpx + constant(safe-area-inset-top)) 36rpx calc(206rpx + constant(safe-area-inset-bottom)); padding: calc(96rpx + env(safe-area-inset-top)) 36rpx calc(206rpx + env(safe-area-inset-bottom)); }
.result-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 14rpx; }
.result-title-row .page-title { min-width: 0; flex: 1 1 100%; }
.status-pill { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 14rpx; color: var(--color-success); background: var(--color-success-soft); border: 2rpx solid var(--color-border); border-radius: 10rpx; font-size: 21rpx; }
.status-pill.is-expired { color: var(--color-text-secondary); background: var(--color-surface); }
.event-note { display: block; margin-top: 16rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.7; }
.created-notice { margin-top: 30rpx; padding: 24rpx; border: 2rpx solid var(--color-border); border-left: 6rpx solid var(--color-success); border-radius: 14rpx; background: var(--color-surface); }
.created-title, .created-copy { display: block; }
.created-title { color: var(--color-success); font-size: 26rpx; font-weight: 600; }
.created-copy { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 23rpx; }
.result-page .section-heading { margin: 40rpx 0 22rpx; }
.result-page .section-heading-text { font-size: 30rpx; }
.best-card { padding: 34rpx; background: var(--color-success); color: var(--color-on-accent); border: 2rpx solid var(--color-success); border-radius: 20rpx; }
.best-card.is-empty { color: var(--color-ink); background: var(--color-surface); border-color: var(--color-border); }
.best-label, .best-time, .best-empty-copy { display: block; }
.best-label { color: var(--color-on-accent); font-size: 23rpx; }
.best-card.is-empty .best-label { color: var(--color-text-secondary); }
.best-time { margin-top: 24rpx; font-size: 50rpx; font-weight: 600; line-height: 1.35; }
.best-date, .best-range { display: block; }
.best-date { font-size: 30rpx; font-weight: 400; }
.best-range { margin-top: 12rpx; font-size: 54rpx; white-space: nowrap; font-variant-numeric: tabular-nums; letter-spacing: -1rpx; }
.best-meta { display: flex; align-items: baseline; justify-content: space-between; margin-top: 30rpx; padding-top: 22rpx; border-top: 2rpx solid rgba(255, 252, 246, .3); }
.best-count { color: var(--color-on-accent); font-size: 26rpx; font-weight: 600; }
.best-percent { color: var(--color-on-accent); font-size: 24rpx; }
.best-empty-copy { margin-top: 16rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.6; }
.stats-row { display: flex; align-items: stretch; margin-top: 20rpx; padding: 28rpx 0; background: var(--color-surface); border: 2rpx solid var(--color-border); border-radius: 16rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; flex: 1; }
.stat-value { color: var(--color-ink); font-size: 52rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.stat-label { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.stat-divider { width: 2rpx; background: var(--color-border); }
.heatmap-help { display: block; color: var(--color-text-secondary); font-size: 23rpx; line-height: 1.7; }
.heatmap-scroll { width: 100%; margin-top: 22rpx; border-radius: 16rpx; overflow: hidden; }
.heatmap-columns { display: inline-flex; gap: 0; }
.heatmap-column { width: 188rpx; flex-shrink: 0; }
.heatmap-date { min-height: 106rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--color-surface); color: var(--color-ink); border: 2rpx solid var(--color-border); }
.heatmap-weekday { color: var(--color-text-secondary); font-size: 21rpx; }
.heatmap-day { margin-top: 8rpx; font-size: 28rpx; font-weight: 600; }
.heatmap-cell { width: 100%; min-height: 106rpx; margin: 0; padding: 18rpx 14rpx; display: flex; align-items: center; justify-content: space-between; gap: 8rpx; background: var(--color-surface); color: var(--color-text-secondary); border: 2rpx solid var(--color-border); border-radius: 0; }
.heatmap-cell + .heatmap-cell { border-top: 0; }
.heatmap-column + .heatmap-column .heatmap-date, .heatmap-column + .heatmap-column .heatmap-cell { border-left: 0; }
.heatmap-cell.level-1 { background: #e5ebdf; color: var(--color-ink); }
.heatmap-cell.level-2 { background: #c4d2bd; color: var(--color-ink); }
.heatmap-cell.level-3 { background: #789371; color: #17271c; }
.heatmap-cell.level-4 { background: var(--color-success); color: var(--color-on-accent); border-color: var(--color-success); }
.heatmap-time { font-size: 22rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.heatmap-count { font-size: 20rpx; white-space: nowrap; }
.participants-list { padding: 0 24rpx; border: 2rpx solid var(--color-border); border-radius: 16rpx; background: var(--color-surface); }
.participant-row { display: flex; align-items: center; gap: 20rpx; min-height: 116rpx; border-bottom: 2rpx solid var(--color-border); }
.participant-row:last-child { border-bottom: 0; }
.participant-avatar { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; flex-shrink: 0; color: #fff; border-radius: 14rpx; font-size: 26rpx; font-weight: 600; }
.participant-body { min-width: 0; flex: 1; }
.participant-name, .participant-meta { display: block; }
.participant-name { color: var(--color-ink); font-size: 26rpx; font-weight: 600; overflow-wrap: anywhere; }
.participant-meta { margin-top: 6rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.action-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 34rpx; }
.action-button { width: 100%; min-width: 0; margin: 0; padding: 0 14rpx; border-radius: 14rpx; font-size: 24rpx; }
.danger-button { display: flex; align-items: center; justify-content: center; min-height: 96rpx; color: var(--color-danger); background: var(--color-surface); border: 2rpx solid var(--color-border); }
.result-footer { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; padding: 20rpx 36rpx; padding: 20rpx 36rpx calc(20rpx + constant(safe-area-inset-bottom)); padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--color-surface); border-top: 2rpx solid var(--color-border); }
.result-primary { width: 100%; margin: 0; }
.state-action { min-width: 240rpx; margin-top: 32rpx; }
.slot-modal { position: fixed; inset: 0; z-index: 60; visibility: hidden; pointer-events: none; }
.slot-modal.is-open { visibility: visible; pointer-events: auto; }
.modal-backdrop { position: absolute; inset: 0; background: rgba(38, 56, 46, .4); opacity: 0; transition: opacity 180ms ease; }
.slot-modal.is-open .modal-backdrop { opacity: 1; }
.slot-sheet { position: absolute; right: 0; bottom: 0; left: 0; max-height: 88vh; overflow-y: auto; box-sizing: border-box; padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); background: var(--color-surface); border-radius: 20rpx 20rpx 0 0; border-top: 2rpx solid var(--color-border); transform: translateY(100%); transition: transform 180ms ease; }
.slot-modal.is-open .slot-sheet { transform: translateY(0); transition-duration: var(--duration-sheet); transition-timing-function: var(--ease-out); }
.slot-sheet-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.slot-sheet-title, .slot-sheet-time { display: block; }
.slot-sheet-title { color: var(--color-ink); font-size: 34rpx; font-weight: 600; }
.slot-sheet-time { margin-top: 8rpx; color: var(--color-text-secondary); font-size: 24rpx; }
.close-button { min-width: 96rpx; min-height: 84rpx; margin: 0; padding: 0 18rpx; color: var(--color-text-secondary); background: var(--color-bg); border: 2rpx solid var(--color-border); border-radius: 12rpx; font-size: 23rpx; }
.slot-sheet-count { display: block; margin-top: 24rpx; color: var(--color-success); font-size: 27rpx; font-weight: 600; }
.slot-user-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.slot-user { padding: 14rpx 20rpx; color: var(--color-ink); background: var(--color-bg); border: 2rpx solid var(--color-border); border-radius: 12rpx; font-size: 23rpx; overflow-wrap: anywhere; }
.no-slot-users { display: block; margin-top: 24rpx; color: var(--color-text-secondary); font-size: 24rpx; }
