.home-page { background: var(--color-bg); }
.home-content { padding: calc(96rpx + env(safe-area-inset-top)) 36rpx calc(64rpx + env(safe-area-inset-bottom)); }
.home-header { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.home-eyebrow { display: block; margin-bottom: 18rpx; color: var(--color-text-secondary); font-size: 22rpx; letter-spacing: 3rpx; }
.brand-title { display: block; font-family: var(--font-display); font-size: 64rpx; font-weight: 700; line-height: 1.2; letter-spacing: -2rpx; }
.brand-subtitle { display: block; margin-top: 14rpx; color: var(--color-text-secondary); font-size: 24rpx; line-height: 1.6; }
.new-event-button { display: flex; align-items: center; justify-content: center; flex-shrink: 0; gap: 8rpx; min-height: 84rpx; margin: 0; padding: 0 22rpx; color: var(--color-on-accent); background: var(--color-success); border-radius: 16rpx; font-size: 25rpx; font-weight: 600; }
.new-event-icon { width: 28rpx; height: 28rpx; filter: brightness(0) invert(1); }
.new-event-button:active { transform: scale(.97); }
.calendar { margin-top: 44rpx; padding: 30rpx 24rpx 24rpx; border: 2rpx solid var(--color-border); border-radius: 20rpx; background: var(--color-surface); color: var(--color-ink); animation-delay: 60ms; }
.calendar-toggle-surface { width: 100%; margin: 0; padding: 0; color: inherit; background: transparent; border-radius: 0; text-align: left; }
.calendar-header { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 0 6rpx 24rpx; border-bottom: 2rpx solid var(--color-border); }
.calendar-caption { display: block; margin-bottom: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.calendar-month { display: block; color: var(--color-ink); font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }
.calendar-expand-control { display: flex; align-items: center; gap: 4rpx; color: var(--color-text-secondary); font-size: 22rpx; }
.calendar-expand-icon { width: 26rpx; height: 26rpx; transform: rotate(90deg); transition: transform 180ms ease; }
.calendar.is-expanded .calendar-expand-icon { transform: rotate(-90deg); }
.calendar-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); margin-top: 22rpx; }
.calendar-day { min-width: 0; min-height: 122rpx; display: flex; flex-direction: column; align-items: center; color: var(--color-ink); }
.calendar-weekday { color: var(--color-text-secondary); font-size: 22rpx; }
.calendar-number { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin-top: 12rpx; border-radius: 14rpx; font-size: 40rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.calendar-day.is-current .calendar-weekday { color: var(--color-coral); }
.calendar-day.is-current .calendar-number { color: var(--color-on-accent); background: var(--color-coral); }
.calendar-dot { display: none; }
.calendar-month-view { margin-top: 16rpx; animation: calendar-reveal 180ms ease both; }
.calendar-month-nav { display: grid; grid-template-columns: 84rpx 1fr 84rpx; align-items: center; padding-bottom: 14rpx; }
.calendar-month-nav-button, .calendar-today-button { display: flex; align-items: center; justify-content: center; min-width: 84rpx; min-height: 84rpx; margin: 0; padding: 0; background: transparent; color: var(--color-ink); border-radius: 12rpx; font-size: 24rpx; }
.calendar-today-button { justify-self: center; padding: 0 24rpx; }
.calendar-month-nav-button:active, .calendar-today-button:active { background: var(--color-bg); }
.calendar-month-nav-icon { width: 28rpx; height: 28rpx; }
.calendar-expand-icon, .calendar-month-nav-icon { filter: brightness(.4); }
.calendar-month-nav-icon.is-previous { transform: rotate(180deg); }
.calendar-month-weekdays, .calendar-month-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.calendar-month-weekdays { align-items: center; min-height: 56rpx; color: var(--color-text-secondary); font-size: 22rpx; text-align: center; }
.calendar-month-grid { border-top: 2rpx solid var(--color-border); border-left: 2rpx solid var(--color-border); }
.calendar-month-day { display: flex; align-items: center; justify-content: center; min-height: 80rpx; border-right: 2rpx solid var(--color-border); border-bottom: 2rpx solid var(--color-border); font-size: 28rpx; font-variant-numeric: tabular-nums; }
.calendar-month-day.is-outside { color: var(--color-text-muted); background: var(--color-bg); }
.calendar-month-day.is-current { color: var(--color-on-accent); background: var(--color-coral); font-weight: 700; }
.calendar-collapse-button { min-height: 80rpx; margin: 10rpx 0 0; padding: 0; color: var(--color-text-secondary); background: transparent; font-size: 22rpx; line-height: 80rpx; }
@keyframes calendar-reveal { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
.home-page .section-heading { margin: 42rpx 0 22rpx; }
.home-page .section-heading-text { font-size: 30rpx; }
.focus-list { display: grid; gap: 16rpx; }
.focus-event { display: flex; align-items: center; gap: 20rpx; min-height: 170rpx; padding: 24rpx; border: 2rpx solid var(--color-border); border-left: 6rpx solid var(--color-success); border-radius: 16rpx; background: var(--color-surface); transition: transform 140ms ease, opacity 140ms ease; }
.focus-event.is-pressed, .event-row:active { transform: scale(.98); opacity: .86; }
.event-date-mark { display: flex; align-items: center; justify-content: center; width: 76rpx; height: 88rpx; flex-shrink: 0; background: var(--color-bg); border: 2rpx solid var(--color-border); border-radius: 12rpx; }
.event-date-mark-small { width: 70rpx; height: 76rpx; }
.event-icon { width: 42rpx; height: 42rpx; }
.event-icon-small { width: 36rpx; height: 36rpx; }
.event-body { min-width: 0; flex: 1; }
.event-title { display: block; color: var(--color-ink); font-size: 30rpx; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
.event-title-small { font-size: 28rpx; }
.event-progress, .event-meta { display: block; margin-top: 8rpx; color: var(--color-text-secondary); font-size: 22rpx; line-height: 1.5; }
.event-progress-strong { margin-right: 6rpx; color: var(--color-success); font-weight: 700; }
.event-cta { display: flex; align-items: center; flex-shrink: 0; gap: 2rpx; color: var(--color-success); font-size: 22rpx; font-weight: 600; }
.event-cta-icon { width: 26rpx; height: 26rpx; }
.event-list { overflow: hidden; border-top: 2rpx solid var(--color-border); }
.event-swipe-row { position: relative; min-height: 140rpx; border-bottom: 2rpx solid var(--color-border); overflow: hidden; }
.event-row { position: relative; z-index: 2; display: flex; align-items: center; gap: 22rpx; min-height: 140rpx; padding: 18rpx 0; background: var(--color-bg); transition: transform 140ms ease, opacity 140ms ease; }
.event-state-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.delete-action { position: absolute; top: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; width: 140rpx; margin: 0; background: var(--color-danger); color: var(--color-on-accent); border-radius: 0; font-size: 24rpx; }
.retry-button, .empty-action { min-width: 240rpx; margin-top: 32rpx; }
