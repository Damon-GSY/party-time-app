.home-page {
  background-color: var(--color-bg);
}

.home-content {
  padding: calc(96rpx + env(safe-area-inset-top)) 44rpx calc(74rpx + env(safe-area-inset-bottom));
}

.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.brand-title {
  display: block;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: 1rpx;
}

.brand-subtitle {
  display: block;
  max-width: 430rpx;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.new-event-button {
  min-width: 192rpx;
  min-height: 96rpx;
  margin: 0;
  gap: 10rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-coral);
  color: #1a1412;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 700;
}

.new-event-icon {
  width: 34rpx;
  height: 34rpx;
}

.new-event-button:active {
  transform: scale(0.97);
}

.calendar {
  margin-top: 48rpx;
  animation-delay: 70ms;
}

.calendar-month {
  color: var(--color-coral);
  font-size: 38rpx;
  font-weight: 700;
}

.calendar-week {
  display: flex;
  justify-content: space-between;
  margin-top: 36rpx;
}

.calendar-day {
  width: 88rpx;
  min-height: 142rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: var(--color-text-secondary);
}

.calendar-weekday {
  font-size: 26rpx;
}

.calendar-number {
  width: 90rpx;
  height: 90rpx;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  font-size: 48rpx;
  font-weight: 600;
}

.calendar-day.is-current .calendar-weekday {
  color: var(--color-coral);
  font-weight: 600;
}

.calendar-day.is-current .calendar-number {
  background: var(--color-coral);
  color: #1a1412;
}

.calendar-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: -14rpx;
  border-radius: 50%;
  background: #1a1412;
}

.focus-event,
.event-row {
  display: flex;
  align-items: center;
  transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) ease;
}

.focus-event {
  gap: 30rpx;
  min-height: 226rpx;
  padding: 30rpx 0 38rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.focus-event.is-pressed,
.event-row:active {
  transform: scale(0.98);
  opacity: 0.86;
}

.event-date-mark {
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 118, 104, 0.55);
  border-radius: 50%;
}

.event-date-mark-small {
  width: 128rpx;
  height: 128rpx;
  border-color: var(--color-border);
}

.event-icon {
  width: 58rpx;
  height: 58rpx;
}

.event-icon-small {
  width: 54rpx;
  height: 54rpx;
}

.event-body {
  min-width: 0;
  flex: 1;
}

.event-title {
  display: block;
  overflow: hidden;
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-title-small {
  font-size: 36rpx;
}

.event-progress,
.event-meta {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
}

.event-progress-strong {
  margin-right: 8rpx;
  color: var(--color-coral);
  font-weight: 700;
}

.event-cta {
  min-width: 218rpx;
  min-height: 100rpx;
  margin: 0;
  gap: 6rpx;
  padding: 0 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-coral);
  color: #1a1412;
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 700;
}

.event-cta-icon {
  width: 34rpx;
  height: 34rpx;
}

.event-list {
  overflow: hidden;
}

.event-swipe-row {
  position: relative;
  min-height: 172rpx;
  border-bottom: 2rpx solid var(--color-border);
  overflow: hidden;
}

.event-row {
  position: relative;
  z-index: 2;
  gap: 24rpx;
  min-height: 172rpx;
  background: var(--color-bg);
}

.event-state-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-danger);
  color: #211614;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.retry-button,
.empty-action {
  min-width: 240rpx;
  margin-top: 32rpx;
}
