.home-page {
  background: #151311;
}

.home-content {
  padding: 36rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
}

.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.brand-title {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: 1rpx;
}

.brand-subtitle {
  display: block;
  max-width: 430rpx;
  margin-top: 12rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.new-event-button {
  min-width: 154rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-coral);
  color: #1a1412;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 700;
}

.new-event-button:active {
  transform: scale(0.97);
}

.calendar {
  margin-top: 54rpx;
  animation-delay: 70ms;
}

.calendar-month {
  color: var(--color-coral);
  font-size: 34rpx;
  font-weight: 700;
}

.calendar-week {
  display: flex;
  justify-content: space-between;
  margin-top: 28rpx;
}

.calendar-day {
  width: 78rpx;
  min-height: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: var(--color-text-secondary);
}

.calendar-weekday {
  font-size: 22rpx;
}

.calendar-number {
  width: 76rpx;
  height: 76rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 600;
}

.calendar-day.is-current .calendar-weekday {
  color: var(--color-coral);
  font-weight: 600;
}

.calendar-day.is-current .calendar-number {
  background: var(--color-coral);
  color: #1a1412;
}

.calendar-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: -14rpx;
  border-radius: 50%;
  background: #1a1412;
}

.focus-event,
.event-row {
  display: flex;
  align-items: center;
  transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) ease;
}

.focus-event {
  gap: 26rpx;
  min-height: 196rpx;
  padding: 26rpx 0 34rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.focus-event.is-pressed,
.event-row.is-pressed,
.event-row:active {
  transform: scale(0.98);
  opacity: 0.86;
}

.event-date-mark {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 118, 104, 0.55);
  border-radius: 50%;
}

.event-date-mark-small {
  width: 92rpx;
  height: 92rpx;
  border-color: var(--color-border);
}

.event-date-month {
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1;
}

.event-date-day {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.event-date-mark-small .event-date-day {
  font-size: 30rpx;
}

.event-body {
  min-width: 0;
  flex: 1;
}

.event-title {
  display: block;
  overflow: hidden;
  color: var(--color-text);
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-title-small {
  font-size: 30rpx;
}

.event-progress,
.event-meta {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.event-progress-strong {
  margin-right: 8rpx;
  color: var(--color-coral);
  font-weight: 700;
}

.event-cta {
  min-width: 168rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 26rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-coral);
  color: #1a1412;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 700;
}

.event-list {
  overflow: hidden;
}

.event-swipe-row {
  position: relative;
  min-height: 150rpx;
  border-bottom: 2rpx solid var(--color-border);
  overflow: hidden;
}

.event-row {
  position: relative;
  z-index: 2;
  gap: 24rpx;
  min-height: 150rpx;
  background: var(--color-bg);
}

.event-state {
  min-width: 74rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  text-align: right;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-danger);
  color: #211614;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.retry-button,
.empty-action {
  min-width: 240rpx;
  margin-top: 32rpx;
}
