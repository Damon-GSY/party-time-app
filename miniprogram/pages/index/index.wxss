.home-page {
  background-color: var(--color-bg);
}

.home-content {
  padding: calc(96rpx + env(safe-area-inset-top)) 44rpx calc(74rpx + env(safe-area-inset-bottom));
}

.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.brand-title {
  display: block;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: 1rpx;
}

.brand-subtitle {
  display: block;
  max-width: 430rpx;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.new-event-button {
  min-width: 192rpx;
  min-height: 96rpx;
  margin: 0;
  gap: 10rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-coral);
  color: var(--color-on-accent);
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  font-weight: 700;
}

.new-event-icon {
  width: 34rpx;
  height: 34rpx;
}

.new-event-button:active {
  transform: scale(0.97);
}

.calendar {
  margin-top: 48rpx;
  padding: 34rpx 28rpx 24rpx;
  background: var(--color-paper);
  color: var(--color-ink);
  border-radius: 32rpx;
  animation-delay: 70ms;
  transition: transform var(--duration-fast) var(--ease-out), border-radius var(--duration-fast) ease;
}

.calendar.is-expanded {
  border-radius: 18rpx;
}

.calendar-toggle-surface {
  width: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  border: 0;
  border-radius: 0;
  text-align: left;
  transition: opacity var(--duration-fast) ease;
}

.calendar-toggle-surface:active,
.calendar-collapse-button:active,
.calendar-month-nav-button:active,
.calendar-today-button:active {
  opacity: 0.72;
}

.calendar-header {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.calendar-month {
  color: var(--color-coral);
  font-size: 38rpx;
  font-weight: 700;
}

.calendar-expand-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: rgba(23, 24, 23, 0.7);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.calendar-expand-icon {
  width: 30rpx;
  height: 30rpx;
  transform: rotate(90deg);
  transition: transform var(--duration-base) var(--ease-out);
}

.calendar.is-expanded .calendar-expand-icon {
  transform: rotate(-90deg);
}

.calendar-week {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  margin-top: 36rpx;
}

.calendar-day {
  min-width: 0;
  min-height: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: rgba(23, 24, 23, 0.68);
}

.calendar-weekday {
  font-size: 26rpx;
}

.calendar-number {
  width: 76rpx;
  height: 76rpx;
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  font-size: 48rpx;
  font-weight: 600;
}

.calendar-day.is-current .calendar-weekday {
  color: var(--color-coral);
  font-weight: 600;
}

.calendar-day.is-current .calendar-number {
  background: var(--color-coral);
  color: var(--color-on-accent);
}

.calendar-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: -14rpx;
  border-radius: 50%;
  background: var(--color-on-accent);
}

.calendar-month-view {
  margin-top: 28rpx;
  border-top: 2rpx solid rgba(23, 24, 23, 0.28);
  animation: calendar-reveal var(--duration-base) var(--ease-out) both;
}

.calendar-month-nav {
  min-height: 82rpx;
  display: grid;
  grid-template-columns: 82rpx 1fr 82rpx;
  align-items: center;
  border-bottom: 2rpx solid rgba(23, 24, 23, 0.28);
}

.calendar-month-nav-button,
.calendar-today-button {
  min-width: 82rpx;
  min-height: 82rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--color-ink);
  border: 0;
  border-radius: 0;
}

.calendar-today-button {
  justify-self: center;
  min-width: 112rpx;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 22rpx;
  font-weight: 600;
}

.calendar-month-nav-icon {
  width: 30rpx;
  height: 30rpx;
}

.calendar-month-nav-icon.is-previous {
  transform: rotate(180deg);
}

.calendar-month-weekdays,
.calendar-month-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.calendar-month-weekdays {
  min-height: 62rpx;
  align-items: center;
  color: rgba(23, 24, 23, 0.7);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.calendar-month-grid {
  border-top: 2rpx solid rgba(23, 24, 23, 0.28);
  border-left: 2rpx solid rgba(23, 24, 23, 0.28);
}

.calendar-month-day {
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 2rpx solid rgba(23, 24, 23, 0.28);
  border-bottom: 2rpx solid rgba(23, 24, 23, 0.28);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.calendar-month-day.is-outside {
  color: rgba(23, 24, 23, 0.68);
}

.calendar-month-day.is-current {
  background: var(--color-coral);
  color: var(--color-on-accent);
  font-weight: 700;
}

.calendar-collapse-button {
  min-height: 62rpx;
  margin: 18rpx 0 0 auto;
  padding: 0;
  background: transparent;
  color: rgba(23, 24, 23, 0.7);
  border: 0;
  border-radius: 0;
  font-size: 22rpx;
  line-height: 62rpx;
  text-align: right;
}

@keyframes calendar-reveal {
  from { opacity: 0; transform: translateY(-12rpx) scale(0.99); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.focus-event,
.event-row {
  display: flex;
  align-items: center;
  transition: transform var(--duration-fast) var(--ease-out), opacity var(--duration-fast) ease;
}

.focus-event {
  gap: 30rpx;
  min-height: 226rpx;
  padding: 30rpx;
  background: var(--color-paper);
  border-radius: 30rpx;
}

.focus-event .event-title { color: var(--color-ink); }
.focus-event .event-progress { color: rgba(23, 24, 23, 0.66); }

.focus-event.is-pressed,
.event-row:active {
  transform: scale(0.98);
  opacity: 0.86;
}

.event-date-mark {
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(184, 58, 45, 0.62);
  border-radius: 50%;
}

.event-date-mark-small {
  width: 128rpx;
  height: 128rpx;
  border-color: var(--color-border);
}

.event-icon {
  width: 58rpx;
  height: 58rpx;
}

.event-icon-small {
  width: 54rpx;
  height: 54rpx;
}

.event-body {
  min-width: 0;
  flex: 1;
}

.event-title {
  display: block;
  overflow: hidden;
  color: var(--color-text);
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-title-small {
  font-size: 36rpx;
}

.event-progress,
.event-meta {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
}

.event-progress-strong {
  margin-right: 8rpx;
  color: var(--color-coral);
  font-weight: 700;
}

.event-cta {
  min-width: 218rpx;
  min-height: 100rpx;
  margin: 0;
  gap: 6rpx;
  padding: 0 28rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-coral);
  color: var(--color-on-accent);
  border-radius: var(--radius-pill);
  font-size: 30rpx;
  font-weight: 700;
}

.event-cta-icon {
  width: 34rpx;
  height: 34rpx;
}

.event-list {
  overflow: hidden;
}

.event-swipe-row {
  position: relative;
  min-height: 172rpx;
  border-bottom: 2rpx solid var(--color-border);
  overflow: hidden;
}

.event-row {
  position: relative;
  z-index: 2;
  gap: 24rpx;
  min-height: 172rpx;
  background: var(--color-bg);
}

.event-state-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 140rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-danger);
  color: #211614;
  border-radius: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.retry-button,
.empty-action {
  min-width: 240rpx;
  margin-top: 32rpx;
}
