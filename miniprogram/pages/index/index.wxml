<view class="page-shell home-page">
  <image class="grain-layer" src="/assets/textures/warm-grain.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="home-content">
    <view class="home-header enter">
      <view>
        <text class="brand-title">聚会时间</text>
      </view>
      <button class="new-event-button" bindtap="goToCreate">
        <image class="new-event-icon" src="/assets/icons/plus-dark.png" mode="aspectFit" aria-hidden="true"></image>
        <text>新建</text>
      </button>
    </view>

    <view class="calendar enter {{calendarExpanded ? 'is-expanded' : ''}}">
      <button
        class="calendar-toggle-surface"
        bindtap="toggleCalendar"
        aria-expanded="{{calendarExpanded}}"
        aria-controls="home-month-calendar"
        aria-label="{{calendarExpanded ? '收起完整月历' : '展开完整月历'}}"
      >
        <view class="calendar-header">
          <text class="calendar-month" aria-live="polite">{{currentMonth}}</text>
          <view class="calendar-expand-control" aria-hidden="true">
            <text>{{calendarExpanded ? '收起月历' : '查看整月'}}</text>
            <image class="calendar-expand-icon" src="/assets/icons/chevron-right-dark.png" mode="aspectFit"></image>
          </view>
        </view>

        <view class="calendar-week" wx:if="{{!calendarExpanded}}">
          <view class="calendar-day {{item.current ? 'is-current' : ''}}" wx:for="{{calendarDays}}" wx:key="date">
            <text class="calendar-weekday">{{item.weekday}}</text>
            <text class="calendar-number">{{item.day}}</text>
            <view class="calendar-dot" wx:if="{{item.current}}"></view>
          </view>
        </view>
      </button>

      <view id="home-month-calendar" class="calendar-month-view" wx:if="{{calendarExpanded}}" aria-role="region" aria-label="{{currentMonth}}完整月历">
        <view class="calendar-month-nav" aria-role="group" aria-label="月份导航">
          <button class="calendar-month-nav-button" bindtap="showPreviousMonth" aria-label="查看上个月">
            <image class="calendar-month-nav-icon is-previous" src="/assets/icons/chevron-right-dark.png" mode="aspectFit" aria-hidden="true"></image>
          </button>
          <button class="calendar-today-button" bindtap="showTodayMonth" aria-label="回到本月">今天</button>
          <button class="calendar-month-nav-button" bindtap="showNextMonth" aria-label="查看下个月">
            <image class="calendar-month-nav-icon" src="/assets/icons/chevron-right-dark.png" mode="aspectFit" aria-hidden="true"></image>
          </button>
        </view>
        <view class="calendar-month-weekdays">
          <text wx:for="{{calendarWeekdays}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="calendar-month-grid">
          <view
            class="calendar-month-day {{item.inMonth ? '' : 'is-outside'}} {{item.current ? 'is-current' : ''}}"
            wx:for="{{monthCalendarDays}}"
            wx:key="date"
            aria-role="text"
            aria-label="{{item.accessibleLabel}}"
            aria-current="{{item.current ? 'date' : 'false'}}"
          >
            <text>{{item.day}}</text>
          </view>
        </view>
        <button class="calendar-collapse-button" bindtap="toggleCalendar" aria-label="收起完整月历">点击这里收起</button>
      </view>
    </view>

    <view class="loading-state" wx:if="{{loading && events.length === 0}}">
      <view class="loading-dot"></view>
      <text class="state-copy">正在同步你的聚会</text>
    </view>

    <view class="error-state" wx:elif="{{loadError}}">
      <text class="state-title">暂时无法加载</text>
      <text class="state-copy">检查网络后再试一次，你的聚会数据不会丢失。</text>
      <button class="secondary-button retry-button" bindtap="refreshEvents">重新加载</button>
    </view>

    <block wx:else>
      <view class="section-heading" wx:if="{{pendingEvents.length > 0}}">
        <text class="section-heading-text">进行中</text>
      </view>

      <view class="focus-list" wx:if="{{pendingEvents.length > 0}}">
        <view
          class="focus-event {{cardPressedId === item._id ? 'is-pressed' : ''}}"
          wx:for="{{pendingEvents}}"
          wx:key="_id"
          data-id="{{item._id}}"
          data-type="{{item.type}}"
          aria-role="button"
          aria-label="{{item.name}}，{{item.participantCount || 0}} 人已填写，{{item.dateRangeText}}，填写时间"
          bindtap="goToEvent"
          bindlongpress="onCardLongPress"
          bindtouchstart="onCardTouchStart"
          bindtouchend="onCardTouchEnd"
        >
          <view class="event-date-mark">
            <image class="event-icon" src="{{item.iconPath}}" mode="aspectFit" aria-hidden="true"></image>
          </view>
          <view class="event-body">
            <text class="event-title">{{item.name}}</text>
            <text class="event-progress"><text class="event-progress-strong">{{item.participantCount || 0}} 人</text>已填写</text>
            <text class="event-meta">{{item.dateRangeText}}</text>
          </view>
          <view class="event-cta" aria-hidden="true">
            <text>填写时间</text>
            <image class="event-cta-icon" src="/assets/icons/chevron-right-dark.png" mode="aspectFit"></image>
          </view>
        </view>
      </view>

      <view class="section-heading">
        <text class="section-heading-text">最近聚会</text>
      </view>

      <view class="event-list" wx:if="{{recentEvents.length > 0}}">
        <view class="event-swipe-row" wx:for="{{recentEvents}}" wx:key="_id">
          <view
            class="event-row"
            style="transform: translateX({{item.translateX || 0}}rpx) scale({{cardPressedId === item._id ? 0.98 : 1}}); opacity: {{cardPressedId === item._id ? 0.86 : 1}};"
            data-id="{{item._id}}"
            data-type="{{item.type}}"
            aria-role="button"
            aria-label="{{item.name}}，{{item.expired ? '已结束' : item.expireText}}，{{item.participantCount || 0}} 人参与，查看聚会"
            bindtap="goToEvent"
            bindlongpress="onCardLongPress"
            bindtouchstart="onSwipeStart"
            bindtouchend="onSwipeEnd"
          >
            <view class="event-date-mark event-date-mark-small">
              <image class="event-icon event-icon-small" src="{{item.iconPath}}" mode="aspectFit" aria-hidden="true"></image>
            </view>
            <view class="event-body">
              <text class="event-title event-title-small">{{item.name}}</text>
              <text class="event-meta">{{item.expired ? '已结束' : item.expireText}} · {{item.participantCount || 0}} 人参与</text>
            </view>
            <image class="event-state-icon" src="{{item.expired ? '/assets/icons/check-coral.png' : '/assets/icons/chevron-right-muted.png'}}" mode="aspectFit" aria-hidden="true"></image>
          </view>
          <button class="delete-action" wx:if="{{item.type === 'created'}}" data-id="{{item._id}}" bindtap="deleteEvent">删除</button>
        </view>
      </view>

      <view class="empty-state" wx:if="{{events.length === 0}}">
        <text class="state-title">还没有聚会</text>
        <text class="state-copy">创建第一个时间投票，邀请朋友一起选。</text>
        <button class="primary-button empty-action" bindtap="goToCreate">创建聚会</button>
      </view>
    </block>
  </view>
</view>
