<view class="page-shell vote-page">
  <image class="grain-layer" src="/assets/textures/warm-grain.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="loading-state" wx:if="{{loading}}">
    <button class="core-back-button state-back-button" bindtap="goBack" aria-label="返回聚会首页"><image class="core-back-icon" src="/assets/icons/arrow-left-primary.png" mode="aspectFit" aria-hidden="true"></image></button>
    <view class="loading-dot"></view>
    <text class="state-copy">正在打开时间表</text>
  </view>

  <view class="error-state" wx:elif="{{loadError}}">
    <button class="core-back-button state-back-button" bindtap="goBack" aria-label="返回聚会首页"><image class="core-back-icon" src="/assets/icons/arrow-left-primary.png" mode="aspectFit" aria-hidden="true"></image></button>
    <text class="state-title">暂时无法打开活动</text>
    <text class="state-copy">活动可能已被删除，或网络暂时不可用。</text>
    <button class="secondary-button state-action" bindtap="retryLoad">重新加载</button>
  </view>

  <view class="error-state" wx:elif="{{expired}}">
    <button class="core-back-button state-back-button" bindtap="goBack" aria-label="返回聚会首页"><image class="core-back-icon" src="/assets/icons/arrow-left-primary.png" mode="aspectFit" aria-hidden="true"></image></button>
    <text class="state-title">投票已经结束</text>
    <text class="state-copy">你仍然可以查看大家最终选出的时间。</text>
    <button class="primary-button state-action" bindtap="goToResult">查看结果</button>
  </view>

  <block wx:else>
    <view class="vote-content">
      <view class="vote-header core-flow-header enter">
        <button class="core-back-button" bindtap="goBack" aria-label="返回聚会首页"><image class="core-back-icon" src="/assets/icons/arrow-left-primary.png" mode="aspectFit" aria-hidden="true"></image></button>
        <view class="core-flow-body">
          <text class="eyebrow">留出你的相聚时间</text>
          <text class="page-title">{{event.name}}</text>
          <text class="page-subtitle">{{event.dateRangeText}} · {{participantCount}} 人已填写</text>
          <text class="event-note" wx:if="{{event.note}}">{{event.note}}</text>
        </view>
      </view>

      <view class="scheduler-board enter">
        <view class="nickname-field">
          <view class="field-label"><text>你的昵称</text><text class="field-optional">选填</text></view>
          <input
            class="field-input"
            placeholder="匿名参与也可以"
            placeholder-class="placeholder"
            value="{{nickname}}"
            bindinput="onNicknameInput"
            bindfocus="onKeyboardFocus"
            bindblur="onKeyboardBlur"
            maxlength="20"
            aria-label="你的昵称，选填"
            cursor-spacing="150"
          />
        </view>

        <view class="scheduler-section-label">
          <text>先选一天</text>
          <text>左右滑动查看日期</text>
        </view>
        <scroll-view scroll-x class="date-scroll" enhanced show-scrollbar="false">
          <view class="date-tabs">
            <button
              class="date-tab {{currentDateIndex === index ? 'is-active' : ''}}"
              wx:for="{{dates}}"
              wx:key="date"
              bindtap="switchDate"
              data-index="{{index}}"
              aria-selected="{{currentDateIndex === index}}"
              aria-label="{{item.weekday}} {{item.day}} 日，{{currentDateIndex === index ? '当前日期' : '选择日期'}}"
            >
              <text class="date-weekday">{{item.weekday}}</text>
              <text class="date-day">{{item.day}}</text>
            </button>
          </view>
        </scroll-view>

        <view class="day-toolbar">
          <view>
            <text class="day-title">什么时候有空</text>
            <text class="day-caption">{{dates[currentDateIndex].weekday}} · 当天已选 {{currentSelectedCount}} 个</text>
          </view>
          <view class="day-actions">
            <button class="compact-button" bindtap="clearSelection" disabled="{{currentSelectedCount === 0}}">清空</button>
            <button class="compact-button is-accent" bindtap="selectAll" disabled="{{allCurrentSelected}}">全选</button>
          </view>
        </view>

        <view class="slots-grid {{gridVisible ? 'is-visible' : 'is-hidden'}}">
          <button
            class="slot-button {{item.selected ? 'is-selected' : ''}}"
            wx:for="{{currentSlots}}"
            wx:key="id"
            bindtap="toggleSlot"
            data-index="{{index}}"
            aria-pressed="{{item.selected}}"
            aria-label="{{item.timeLabel}}，{{item.selected ? '已选择' : '未选择'}}"
          >
            <text class="slot-label">{{item.shortLabel}}</text>
            <text class="slot-state">{{item.selected ? '已选 · 我有空' : '点击选择'}}</text>
          </button>
        </view>
      </view>
    </view>

    <view class="vote-footer safe-footer {{keyboardActive ? 'is-keyboard-hidden' : ''}}">
      <view class="selected-summary">
        <text class="selected-kicker" aria-hidden="true">我的空闲时间</text>
        <view><text class="selected-number">{{selectedCount}}</text><text class="selected-label"> 个时段</text></view>
        <text class="selected-detail">{{dates[currentDateIndex].weekday}} · 已选 {{currentSelectedCount}}</text>
      </view>
      <button
        class="primary-button vote-submit"
        bindtap="handleSubmit"
        disabled="{{selectedCount === 0 || submitting}}"
      >{{submitting ? '正在提交' : '提交我的时间'}}</button>
    </view>

    <view wx:if="{{successMounted}}" class="success-modal {{showSuccess ? 'is-open' : ''}}" catchtouchmove="preventMove">
      <view class="modal-backdrop" bindtap="closeSuccess"></view>
      <view class="success-sheet" aria-role="dialog" aria-label="时间已提交">
        <view class="success-icon"><image class="success-icon-image" src="/assets/icons/check-coral.png" mode="aspectFit" aria-hidden="true"></image></view>
        <text class="success-title">时间已提交</text>
        <text class="success-copy">已保存 {{selectedCount}} 个时段，你可以继续修改或查看当前结果。</text>
        <button class="primary-button modal-primary" bindtap="goToResult">查看结果</button>
        <button class="secondary-button modal-secondary" bindtap="closeSuccess">继续修改</button>
        <button class="reminder-button" bindtap="requestSubscribe" wx:if="{{notificationsConfigured && !subscribeRequested}}">接收结果提醒</button>
      </view>
    </view>
  </block>
</view>
