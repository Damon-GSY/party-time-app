.vote-page {
  background: var(--color-bg);
}

.vote-content {
  padding: 96rpx 44rpx 206rpx;
  padding: calc(96rpx + constant(safe-area-inset-top)) 44rpx calc(206rpx + constant(safe-area-inset-bottom));
  padding: calc(96rpx + env(safe-area-inset-top)) 44rpx calc(206rpx + env(safe-area-inset-bottom));
}

.event-note {
  display: block;
  margin-top: 18rpx;
  padding-left: 18rpx;
  color: var(--color-text-secondary);
  border-left: 4rpx solid var(--color-border);
  font-size: 24rpx;
  line-height: 1.6;
}

.nickname-field {
  margin-top: 46rpx;
  animation-delay: 60ms;
}

.selection-help {
  display: block;
  margin-top: -12rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
}

.date-scroll {
  width: calc(100% + 40rpx);
  margin-top: 28rpx;
}

.date-tabs {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 40rpx;
}

.date-tab {
  width: 136rpx;
  min-height: 132rpx;
  margin: 0;
  padding: 12rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  border-radius: var(--radius-md);
  transition: color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), transform var(--duration-instant) var(--ease-standard);
}

.date-tab:active {
  transform: scale(0.97);
}

.date-tab.is-active {
  color: var(--color-coral);
}

.date-weekday {
  font-size: 21rpx;
}

.date-day {
  width: 72rpx;
  height: 72rpx;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 600;
}

.date-tab.is-active .date-day {
  background: var(--color-coral);
  color: #1b1412;
}

.day-toolbar {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.day-title {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
}

.day-caption {
  display: block;
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.day-actions {
  display: flex;
  gap: 10rpx;
}

.compact-button {
  min-width: 104rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-pill);
  font-size: 23rpx;
}

.compact-button.is-accent {
  color: var(--color-coral);
  border-color: rgba(255, 118, 104, 0.5);
}

.compact-button[disabled] {
  opacity: 0.4;
}

.slots-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
  transition: opacity 100ms ease, transform 100ms ease;
}

.slots-grid.is-hidden {
  opacity: 0;
  transform: translateY(8rpx);
  pointer-events: none;
}

.slot-button {
  min-width: 0;
  min-height: 116rpx;
  margin: 0;
  padding: 12rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) ease, border-color var(--duration-fast) ease;
}

.slot-button:active {
  transform: scale(0.95);
}

.slot-button.is-selected {
  background: var(--color-coral);
  color: #1a1412;
  border-color: var(--color-coral);
}

.slot-label {
  font-size: 23rpx;
  font-weight: 600;
}

.slot-state {
  margin-top: 6rpx;
  font-size: 19rpx;
  opacity: 0.76;
}

.vote-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  min-height: 150rpx;
  padding: 20rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-border);
  transition: transform 180ms var(--ease-in), opacity 140ms ease;
}

.vote-footer.is-keyboard-hidden {
  transform: translateY(100%);
  opacity: 0;
  pointer-events: none;
}

.selected-summary {
  min-width: 120rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.selected-number {
  color: var(--color-coral);
  font-size: 58rpx;
  font-weight: 700;
}

.selected-label {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.vote-submit {
  min-height: 92rpx;
  margin: 0;
  flex: 1;
}

.state-action {
  min-width: 240rpx;
  margin-top: 32rpx;
}

.success-modal {
  position: fixed;
  inset: 0;
  z-index: 50;
  visibility: hidden;
  pointer-events: none;
}

.success-modal.is-open {
  visibility: visible;
  pointer-events: auto;
}

.modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.66);
  opacity: 0;
  transition: opacity 180ms var(--ease-standard);
}

.success-modal.is-open .modal-backdrop {
  opacity: 1;
}

.success-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 48rpx 40rpx calc(34rpx + env(safe-area-inset-bottom));
  background: var(--color-surface-raised);
  border-radius: 36rpx 36rpx 0 0;
  border-top: 2rpx solid var(--color-border);
  transform: translateY(100%);
  transition: transform 180ms var(--ease-in);
}

.success-modal.is-open .success-sheet {
  transform: translateY(0);
  transition-duration: var(--duration-sheet);
  transition-timing-function: var(--ease-out);
}

.success-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-coral-soft);
  border-radius: 50%;
}

.success-icon-image {
  width: 54rpx;
  height: 54rpx;
}

.success-title {
  display: block;
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.success-copy {
  display: block;
  margin: 12rpx 0 30rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.modal-primary,
.modal-secondary {
  width: 100%;
  margin: 16rpx 0 0;
}

.reminder-button {
  min-height: 88rpx;
  margin: 18rpx 0 0;
  background: transparent;
  color: var(--color-coral);
  font-size: 24rpx;
}
