<view class="page-shell create-page">
  <image class="grain-layer" src="/assets/textures/warm-grain.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="create-content">
    <view class="create-header core-flow-header enter">
      <button class="core-back-button" bindtap="goBack" aria-label="返回聚会首页"><image class="core-back-icon" src="/assets/icons/arrow-left-primary.png" mode="aspectFit" aria-hidden="true"></image></button>
      <view class="core-flow-body">
        <text class="eyebrow">新聚会</text>
        <text class="page-title">先定范围，再让大家选时间</text>
        <text class="page-subtitle">只需要基本信息，创建后就能把投票分享出去。</text>
      </view>
    </view>

    <form bindsubmit="handleSubmit">
      <view class="form-field enter">
        <view class="field-label">
          <text>聚会名称</text><text class="field-required">必填</text>
        </view>
        <input
          class="field-input {{focusedField === 'name' ? 'is-focused' : ''}}"
          name="name"
          placeholder="例如：周末聚餐"
          placeholder-class="placeholder"
          value="{{name}}"
          bindinput="onNameInput"
          maxlength="30"
          data-field="name"
          aria-label="聚会名称，必填"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          cursor-spacing="24"
        />
        <text class="field-hint field-count">{{name.length || 0}} / 30</text>
      </view>

      <view class="form-field enter">
        <view class="field-label">
          <text>日期范围</text><text class="field-required">必填</text>
        </view>
        <view class="date-picker-row">
          <picker class="date-picker-control" mode="date" value="{{startDate}}" start="{{today}}" bindchange="onStartDateChange" aria-label="开始日期，必填">
            <view class="field-picker {{startDate ? '' : 'placeholder'}}">{{startDate || '开始日期'}}</view>
          </picker>
          <text class="date-separator">至</text>
          <picker class="date-picker-control" mode="date" value="{{endDate}}" start="{{startDate || today}}" bindchange="onEndDateChange" aria-label="结束日期，必填">
            <view class="field-picker {{endDate ? '' : 'placeholder'}}">{{endDate || '结束日期'}}</view>
          </picker>
        </view>
        <text class="field-hint" wx:if="{{dateCount > 0 && !formError}}">共 {{dateCount}} 天</text>
        <text class="form-error" wx:if="{{formError}}">{{formError}}</text>
      </view>

      <view class="form-field enter">
        <view class="field-label"><text>每日可选时段</text><text class="field-required">必填</text></view>
        <view class="time-window">
          <picker class="time-picker-control" mode="selector" range="{{startHourOptions}}" range-key="label" value="{{startHourIndex}}" bindchange="onStartHourChange" aria-label="每天开始时间，必填">
            <view class="time-picker-card">
              <text class="time-picker-kicker">开始</text>
              <text class="time-picker-value">{{startHourOptions[startHourIndex].label}}</text>
            </view>
          </picker>
          <view class="time-window-rail" aria-hidden="true"><text>至</text><view class="time-window-line"></view></view>
          <picker class="time-picker-control" mode="selector" range="{{endHourOptions}}" range-key="label" value="{{endHourIndex}}" bindchange="onEndHourChange" aria-label="每天结束时间，必填">
            <view class="time-picker-card">
              <text class="time-picker-kicker">结束</text>
              <text class="time-picker-value">{{endHourOptions[endHourIndex].label}}</text>
            </view>
          </picker>
        </view>
        <view class="time-window-summary">
          <text>每天开放 {{dailySlotCount}} 个时段</text>
          <text>{{startHourOptions[startHourIndex].label}}—{{endHourOptions[endHourIndex].label}}</text>
        </view>
      </view>

      <view class="form-field enter">
        <view class="field-label"><text>时段粒度</text></view>
        <view class="segmented-control">
          <button class="segment {{granularity === 'hour' ? 'is-active' : ''}}" data-value="hour" bindtap="selectGranularity" aria-pressed="{{granularity === 'hour'}}" aria-label="1 小时时段，{{granularity === 'hour' ? '已选择' : '未选择'}}">1 小时</button>
          <button class="segment {{granularity === 'twoHours' ? 'is-active' : ''}}" data-value="twoHours" bindtap="selectGranularity" aria-pressed="{{granularity === 'twoHours'}}" aria-label="2 小时时段，{{granularity === 'twoHours' ? '已选择' : '未选择'}}">2 小时</button>
          <button class="segment {{granularity === 'halfDay' ? 'is-active' : ''}}" data-value="halfDay" bindtap="selectGranularity" aria-pressed="{{granularity === 'halfDay'}}" aria-label="6 小时时段，{{granularity === 'halfDay' ? '已选择' : '未选择'}}">6 小时</button>
        </view>
        <text class="field-hint">2 小时适合大多数聚会，也更容易完成投票。</text>
      </view>

      <view class="form-field enter">
        <view class="field-label"><text>投票有效期</text></view>
        <view class="choice-grid">
          <button class="choice {{expireType === '24h' ? 'is-active' : ''}}" data-value="24h" bindtap="selectExpire" aria-pressed="{{expireType === '24h'}}">24 小时</button>
          <button class="choice {{expireType === '3days' ? 'is-active' : ''}}" data-value="3days" bindtap="selectExpire" aria-pressed="{{expireType === '3days'}}">3 天</button>
          <button class="choice {{expireType === '7days' ? 'is-active' : ''}}" data-value="7days" bindtap="selectExpire" aria-pressed="{{expireType === '7days'}}">7 天</button>
          <button class="choice {{expireType === 'never' ? 'is-active' : ''}}" data-value="never" bindtap="selectExpire" aria-pressed="{{expireType === 'never'}}">长期</button>
        </view>
      </view>

      <view class="form-field enter">
        <view class="field-label"><text>备注</text><text class="field-optional">选填</text></view>
        <textarea
          class="field-textarea"
          name="note"
          placeholder="地点、人数或其他说明"
          placeholder-class="placeholder"
          value="{{note}}"
          bindinput="onNoteInput"
          data-field="note"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          maxlength="200"
          cursor-spacing="140"
          aria-label="备注，选填"
        />
        <text class="field-hint field-count">{{note.length || 0}} / 200</text>
      </view>

      <view class="create-footer safe-footer {{focusedField ? 'is-keyboard-hidden' : ''}}">
        <button class="primary-button create-submit" form-type="submit" disabled="{{!canSubmit || submitting}}">
          {{submitting ? '正在创建' : '创建并开始填写'}}
        </button>
      </view>
    </form>
  </view>
</view>
