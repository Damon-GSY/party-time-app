.create-page {
  background: var(--color-bg);
}

.create-content {
  padding: 34rpx 40rpx calc(190rpx + env(safe-area-inset-bottom));
}

.create-header {
  margin-bottom: 54rpx;
}

.form-field {
  position: relative;
  margin-bottom: 46rpx;
}

.form-field:nth-child(2) { animation-delay: 40ms; }
.form-field:nth-child(3) { animation-delay: 80ms; }
.form-field:nth-child(4) { animation-delay: 120ms; }
.form-field:nth-child(5) { animation-delay: 160ms; }

.field-count {
  display: block;
  margin-top: 10rpx;
  text-align: right;
}

.date-picker-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.date-picker-control {
  min-width: 0;
  flex: 1;
}

.field-picker {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 12rpx;
  font-size: 25rpx;
  text-align: center;
}

.date-separator {
  flex-shrink: 0;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.form-error {
  display: block;
  margin-top: 12rpx;
  color: var(--color-danger);
  font-size: 23rpx;
}

.segmented-control {
  display: flex;
  padding: 6rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.segment {
  min-height: 88rpx;
  margin: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--color-text-secondary);
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.segment.is-active {
  background: var(--color-coral-soft);
  color: var(--color-coral);
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.choice {
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 23rpx;
}

.choice.is-active {
  background: var(--color-coral-soft);
  color: var(--color-coral);
  border-color: var(--color-coral);
  font-weight: 600;
}

.field-hint {
  display: block;
  margin-top: 12rpx;
}

.create-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 20rpx 40rpx;
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-border);
}

.create-submit {
  width: 100%;
  margin: 0;
}
