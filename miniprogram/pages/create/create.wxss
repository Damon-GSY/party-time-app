.create-page { background: var(--color-bg); }
.create-content { padding: 96rpx 36rpx 206rpx; padding: calc(96rpx + constant(safe-area-inset-top)) 36rpx calc(206rpx + constant(safe-area-inset-bottom)); padding: calc(96rpx + env(safe-area-inset-top)) 36rpx calc(206rpx + env(safe-area-inset-bottom)); }
.create-header { margin-bottom: 44rpx; }
.form-field { position: relative; margin-bottom: 26rpx; padding: 28rpx; border: 2rpx solid var(--color-border); border-radius: 18rpx; background: var(--color-surface); }
.form-field:nth-child(2) { animation-delay: 40ms; }
.form-field:nth-child(3) { animation-delay: 80ms; }
.form-field:nth-child(4) { animation-delay: 120ms; }
.form-field:nth-child(5) { animation-delay: 160ms; }
.field-step { margin-right: 8rpx; color: var(--color-coral); font-size: 22rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.create-page .field-label { margin-bottom: 22rpx; font-size: 27rpx; }
.create-page .field-required, .create-page .field-optional { margin-left: auto; color: var(--color-text-secondary); font-size: 20rpx; font-weight: 400; }
.create-page .field-input, .create-page .field-textarea, .create-page .field-picker { background: var(--color-bg); border-color: var(--color-border); border-radius: 12rpx; }
.field-count { display: block; margin-top: 10rpx; text-align: right; }
.date-picker-row { display: flex; align-items: center; gap: 12rpx; }
.date-picker-control { flex: 1; min-width: 0; }
.field-picker { display: flex; align-items: center; justify-content: center; min-height: 92rpx; padding: 18rpx 8rpx; font-size: 25rpx; font-variant-numeric: tabular-nums; }
.date-separator { flex-shrink: 0; color: var(--color-text-secondary); font-size: 22rpx; }
.form-error { display: block; margin-top: 12rpx; color: var(--color-danger); font-size: 23rpx; }
.choice-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10rpx; }
.choice { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 86rpx; margin: 0; padding: 0 6rpx; color: var(--color-text-secondary); background: var(--color-bg); border: 2rpx solid var(--color-border); border-radius: 12rpx; font-size: 23rpx; transition: background-color 140ms ease, transform 140ms ease; }
.choice:active { transform: scale(.97); }
.choice.is-active { color: var(--color-on-accent); background: var(--color-success); border-color: var(--color-success); font-weight: 600; }
.field-hint { display: block; margin-top: 12rpx; }
.time-window { display: grid; grid-template-columns: minmax(0, 1fr) 48rpx minmax(0, 1fr); }
.time-picker-control { min-width: 0; }
.time-picker-card { display: flex; flex-direction: column; justify-content: space-between; min-height: 142rpx; padding: 22rpx; box-sizing: border-box; border: 2rpx solid var(--color-border); border-radius: 12rpx; background: var(--color-bg); transition: border-color 140ms ease, transform 140ms ease; }
.time-picker-card:active { border-color: var(--color-success); transform: scale(.98); }
.time-picker-kicker { color: var(--color-text-secondary); font-size: 22rpx; }
.time-picker-value { color: var(--color-ink); font-size: 42rpx; line-height: 1.2; font-weight: 600; font-variant-numeric: tabular-nums; }
.time-window-rail { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: var(--color-text-secondary); font-size: 20rpx; }
.time-window-line { width: 20rpx; height: 2rpx; background: var(--color-border); }
.time-window-summary { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx; margin-top: 18rpx; color: var(--color-text-secondary); font-size: 21rpx; }
.create-footer { position: fixed; right: 0; bottom: 0; left: 0; z-index: 20; padding: 20rpx 36rpx; padding: 20rpx 36rpx calc(20rpx + constant(safe-area-inset-bottom)); padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--color-surface); border-top: 2rpx solid var(--color-border); transition: transform 180ms ease, opacity 140ms ease; }
.create-footer.is-keyboard-hidden { transform: translateY(100%); opacity: 0; pointer-events: none; }
.create-submit { width: 100%; margin: 0; }
