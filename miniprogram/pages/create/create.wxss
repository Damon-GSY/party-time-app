.create-page {
  background: var(--color-bg);
}

.create-content {
  padding: 96rpx 44rpx 206rpx;
  padding: calc(96rpx + constant(safe-area-inset-top)) 44rpx calc(206rpx + constant(safe-area-inset-bottom));
  padding: calc(96rpx + env(safe-area-inset-top)) 44rpx calc(206rpx + env(safe-area-inset-bottom));
}

.create-header {
  margin-bottom: 42rpx;
}

.form-field {
  position: relative;
  margin-bottom: 48rpx;
}

.form-field:nth-child(2) { animation-delay: 40ms; }
.form-field:nth-child(3) { animation-delay: 80ms; }
.form-field:nth-child(4) { animation-delay: 120ms; }
.form-field:nth-child(5) { animation-delay: 160ms; }
.form-field:nth-child(6) { animation-delay: 200ms; }

.field-count {
  display: block;
  margin-top: 10rpx;
  text-align: right;
}

.date-picker-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.date-picker-control {
  min-width: 0;
  flex: 1;
}

.field-picker {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 12rpx;
  font-size: 25rpx;
  text-align: center;
}

.date-separator {
  flex-shrink: 0;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.form-error {
  display: block;
  margin-top: 12rpx;
  color: var(--color-danger);
  font-size: 23rpx;
}

.segmented-control {
  display: flex;
  padding: 6rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.segment {
  min-height: 88rpx;
  margin: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--color-text-secondary);
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 600;
  transition: color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), transform var(--duration-instant) var(--ease-standard);
}

.segment:active,
.choice:active {
  transform: scale(0.97);
}

.segment.is-active {
  background: var(--color-coral-soft);
  color: var(--color-coral);
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.choice {
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-surface);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: 23rpx;
  transition: color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), transform var(--duration-instant) var(--ease-standard);
}

.choice.is-active {
  background: var(--color-coral-soft);
  color: var(--color-coral);
  border-color: var(--color-coral);
  font-weight: 600;
}

.field-hint {
  display: block;
  margin-top: 12rpx;
}

.time-window {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 58rpx minmax(0, 1fr);
  align-items: stretch;
}

.time-picker-control {
  min-width: 0;
}

.time-picker-card {
  min-height: 132rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  transition: border-color var(--duration-fast) var(--ease-standard), transform var(--duration-instant) var(--ease-standard);
}

.time-picker-card:active {
  border-color: var(--color-coral);
  transform: scale(0.98);
}

.time-picker-kicker {
  color: var(--color-text-muted);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
}

.time-picker-value {
  color: var(--color-ink);
  font-family: var(--font-display);
  font-size: 38rpx;
  font-weight: 700;
}

.time-window-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
}

.time-window-line {
  width: 30rpx;
  height: 2rpx;
  background: var(--color-border-strong);
}

.time-window-summary {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.create-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 20rpx 40rpx 20rpx;
  padding: 20rpx 40rpx calc(20rpx + constant(safe-area-inset-bottom));
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-border);
  transition: transform 180ms var(--ease-in), opacity 140ms ease;
}

.create-footer.is-keyboard-hidden {
  transform: translateY(100%);
  opacity: 0;
  pointer-events: none;
}

.create-submit {
  width: 100%;
  margin: 0;
}
