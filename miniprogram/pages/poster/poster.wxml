<view class="page-shell poster-page">
  <view class="loading-state" wx:if="{{loading}}"><view class="loading-dot"></view><text class="state-copy">正在生成海报</text></view>
  <block wx:else>
    <view class="poster-preview"><canvas type="2d" id="posterCanvas" class="poster-canvas" style="width: 375px; height: 667px;"></canvas></view>
    <view class="poster-actions safe-footer">
      <button class="primary-button" bindtap="saveToAlbum">保存到相册</button>
      <button class="secondary-button" open-type="share">分享给好友</button>
    </view>
  </block>
</view>
