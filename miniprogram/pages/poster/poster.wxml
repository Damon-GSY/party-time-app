<view class="page-shell poster-page">
  <image class="grain-layer" src="/assets/textures/warm-grain.jpg" mode="aspectFill" aria-hidden="true"></image>
  <view class="poster-heading"><text class="eyebrow">把邀约分享出去</text><text class="page-title">见面邀请函</text><text class="page-subtitle">保存这张卡片，把好时间分享给朋友。</text></view>
  <view class="loading-state" wx:if="{{loading}}"><view class="loading-dot"></view><text class="state-copy">正在生成海报</text></view>
  <view class="error-state" wx:if="{{!loading && posterError}}"><text class="state-title">邀请函暂时没有生成</text><text class="state-copy">请返回聚会结果页，再试一次。</text></view>
  <view class="poster-preview {{loading || posterError ? 'is-pending' : ''}}"><canvas type="2d" id="posterCanvas" class="poster-canvas" style="width: 375px; height: 667px;"></canvas></view>
  <block wx:if="{{!loading && !posterError}}">
    <view class="poster-actions safe-footer">
      <button class="primary-button" bindtap="saveToAlbum">保存到相册</button>
      <button class="secondary-button" open-type="share">分享给好友</button>
    </view>
  </block>
</view>
