<view class="page-shell notifications-page">
  <view class="notifications-content">
    <view class="notifications-header enter">
      <text class="eyebrow">消息</text>
      <text class="page-title">本机动态</text>
      <text class="page-subtitle">这里只保存你在这台设备上的操作；订阅消息由微信服务通知送达。</text>
    </view>

    <view class="notification-list" wx:if="{{notifications.length > 0}}">
      <button class="notification-row {{item.read ? 'is-read' : 'is-unread'}}" wx:for="{{notifications}}" wx:key="id" bindtap="markAsRead" data-id="{{item.id}}">
        <view class="notification-kind">{{item.label || '消息'}}</view>
        <view class="notification-body">
          <text class="notification-title">{{item.title}}</text>
          <text class="notification-copy">{{item.description}}</text>
          <text class="notification-time">{{item.timeText}}</text>
        </view>
        <view class="unread-dot" wx:if="{{!item.read}}"></view>
      </button>
      <button class="clear-button" bindtap="clearAll">清空通知</button>
    </view>

    <view class="empty-state" wx:else>
      <text class="state-title">暂无通知</text>
      <text class="state-copy">提交时间、订阅提醒或发送结果通知后，操作记录会出现在这里。</text>
    </view>
  </view>
</view>
